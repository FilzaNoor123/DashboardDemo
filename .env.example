# Galaxy agent dashboard — connector configuration
#
# Copy to .env.local and fill in as access arrives. Every system defaults to
# "mock", and each flips independently: the first credentials to land can go
# live on their own while the other three stay on fixtures.
#
# .env.local is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Clock
# ---------------------------------------------------------------------------
# "demo"  — answers as of 25 Aug 2026 14:47, so fixtures tell a stable story
# "live"  — real wall clock. REQUIRED once any connector is live, or hold-time
#           calculations will be wrong in a way that looks right.
AGENT_CLOCK=demo

# ---------------------------------------------------------------------------
# DataNinja — MES / eBR, the execution system of record
# ---------------------------------------------------------------------------
# Separate production, sandbox and validation sites exist.
# BUILD AGAINST THE SANDBOX FIRST — never point this at production while the
# read-only question below is unresolved.
#
# Still open:
#   - The endpoint paths below. There are no defaults on purpose: a guessed
#     endpoint fails like a bug rather than like a missing answer.
#   - Whether a READ-ONLY API role can be issued. This API supports create and
#     update, so the token is the second layer of the read-only guarantee.
DATANINJA_MODE=mock
DATANINJA_BASE_URL=              # the SANDBOX site, not production
DATANINJA_API_TOKEN=           # generated from the site's API setup page
DATANINJA_BATCH_PATH=            # e.g. /api/v1/batches/{id}
DATANINJA_SOP_PATH=              # e.g. /api/v1/sops?effective=true
DATANINJA_VENDOR_LOT_PATH=       # e.g. /api/v1/lots/{id}/consumption
DATANINJA_CUSTODY_PATH=          # e.g. /api/v1/lots/{id}/custody
DATANINJA_BAG_WEIGHTS_PATH=      # e.g. /api/v1/batches/{id}/steps/14

# ---------------------------------------------------------------------------
# NetSuite — ERP: orders, shipments, allocation
# ---------------------------------------------------------------------------
# Token-based auth (OAuth 1.0a TBA) is fully implemented — these five values
# are all the connector needs to authenticate.
#
# In NetSuite: Setup → Integration → Manage Integrations (consumer key/secret),
# then Setup → Users/Roles → Access Tokens (token id/secret). The role must be
# READ-ONLY on Sales Orders and Item Fulfilments.
NETSUITE_MODE=mock
NETSUITE_ACCOUNT_ID=             # e.g. 1234567 or 1234567_SB1
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# Alternative: read the Azure NSAW lake copy instead of NetSuite live.
# Which one is correct is open question §7.2 — a lake copy changes what the
# freshness line on every shipment claim is allowed to say.
NSAW_LAKE_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# QMS — deviations and CAPA
# ---------------------------------------------------------------------------
# The product was never named in the 25 Aug huddle. Confirm which it is before
# wiring anything: veeva | trackwise | mastercontrol | other
QMS_MODE=mock
QMS_VENDOR=
QMS_BASE_URL=
QMS_API_TOKEN=
QMS_DEVIATIONS_PATH=             # filtered by ?batch=<id>

# ---------------------------------------------------------------------------
# OceaView — room log (MET ONE 3400+ continuous monitoring)
# ---------------------------------------------------------------------------
# If OceaView only produces scheduled exports and has no query API, leave the
# paths blank and set OCEAVIEW_EXPORT_PATH — a file-drop connector is then the
# right shape, and the readAt on every room value becomes the export time, not
# the moment of the read.
OCEAVIEW_MODE=mock
OCEAVIEW_BASE_URL=
OCEAVIEW_API_TOKEN=
OCEAVIEW_READINGS_PATH=
OCEAVIEW_LIMITS_PATH=            # or: limits live in a QA-controlled document
OCEAVIEW_SUITE_PATH=             # which rooms a batch was compounded in
OCEAVIEW_EXPORT_PATH=
